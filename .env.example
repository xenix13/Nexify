# Copiez ce fichier vers .env (deploy/install.sh le fait pour vous).

# Secret de chiffrement des jetons et cookies enregistrés (32 caractères aléatoires minimum).
# Générez-le avec : openssl rand -hex 32
APP_SECRET=

# Port et adresse d'écoute
PORT=8443
HOST=0.0.0.0

# HTTPS : nécessaire pour la lecture Spotify dans le navigateur (DRM) et pour la
# redirection OAuth Spotify (seul http://127.0.0.1 est accepté en clair).
# install.sh génère un certificat auto-signé. Pour installer l'appli (PWA) et l'utiliser hors connexion,
# il faut un certificat reconnu : utilisez un reverse proxy (et videz TLS_CERT / TLS_KEY).
TLS_CERT=/opt/nexify/certs/nexify.crt
TLS_KEY=/opt/nexify/certs/nexify.key

# Adresse à laquelle vous ouvrez Nexify dans le navigateur (sans / final).
# Sert à construire l'URI de redirection Spotify : PUBLIC_URL/api/spotify/callback
PUBLIC_URL=https://192.168.1.50:8443

# Dossier des données (comptes, playlists, jetons chiffrés)
DATA_DIR=/opt/nexify/data

# Inscriptions : first (seulement le premier compte, l'admin), yes (ouvertes), no (fermées)
ALLOW_SIGNUP=first

# Spotify : créez une application sur https://developer.spotify.com/dashboard
# (cocher « Web API » et « Web Playback SDK », ajouter l'URI de redirection ci-dessus)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Pays du catalogue et langue des résultats
MARKET=FR
LANG_UI=fr

# yt-dlp (lecture YouTube Music)
YTDLP_BIN=/usr/local/bin/yt-dlp
# Arguments en plus, séparés par des espaces (ex. --js-runtimes node)
YTDLP_EXTRA_ARGS=
# Fichier cookies.txt (format Netscape) si YouTube demande une connexion pour certains titres
YTDLP_COOKIES_FILE=
